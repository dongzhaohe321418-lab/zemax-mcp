  "sources": [
    {
      "id": "ppt_input",
      "label": "用户提供的眼部光学参数 PPT",
      "path": "experiments/eye_illumination/source/小鸡和人眼光学仿真参数.pptx"
    },
    {
      "id": "summary_query",
      "label": "汇总指标 SQL",
      "path": "experiments/eye_illumination/make_report_artifact.py",
      "query": {
        "engine": "sqlite",
        "sql": "SELECT\n(SELECT source_diameter_mm FROM headline_results WHERE eye_id='adult_18y' AND source_demand_D=60) AS adult_60D_source_diameter_mm,\n(SELECT source_diameter_mm FROM headline_results WHERE eye_id='adult_18y' AND source_demand_D=120) AS adult_120D_source_diameter_mm,\n(SELECT angular_diameter_deg FROM infinity_angular_sweep WHERE eye_id='adult_18y' AND source_demand_D=0 AND external_lens_D=0) AS adult_infinity_full_angle_deg,\n(SELECT focused_zos_edge_max_error_um FROM validation_summary) AS zos_max_focused_edge_error_um,\n(SELECT focused_capture_fraction FROM monte_carlo_summary) AS focused_capture_fraction",
        "description": "报告生成器实际执行的 SQLite 查询。",
        "executed_at": "2026-08-14T00:00:00Z",
        "tables_used": [
          "headline_results",
          "infinity_angular_sweep",
          "validation_summary",
          "monte_carlo_summary"
        ]
      }
    },
    {
      "id": "source_size_query",
      "label": "主要光源尺寸 SQL",
      "path": "experiments/eye_illumination/results/headline_results.csv",
      "query": {
        "engine": "sqlite",
        "sql": "SELECT *, printf('%g D', source_demand_D) AS demand_label,\nCASE WHEN feasible_accommodation THEN '可行' ELSE '超出调节范围' END AS feasibility\nFROM headline_results",
        "description": "报告生成器实际执行的 SQLite 查询。",
        "executed_at": "2026-08-14T00:00:00Z",
        "tables_used": [
          "headline_results"
        ]
      }
    },
    {
      "id": "adult_external_query",
      "label": "成人外置镜片参考 SQL",
      "path": "experiments/eye_illumination/results/external_lens_reference.csv",
      "query": {
        "engine": "sqlite",
        "sql": "SELECT external_lens_D, printf('%g D', external_lens_D) AS lens_label,\naccommodation_D, source_diameter_mm, source_area_mm2,\nCASE WHEN feasible_accommodation THEN '可行' ELSE '超出调节范围' END AS feasibility\nFROM external_lens_reference\nWHERE eye_id = 'adult_18y'",
        "description": "报告生成器实际执行的 SQLite 查询。",
        "executed_at": "2026-08-14T00:00:00Z",
        "tables_used": [
          "external_lens_reference"
        ]
      }
    },
    {
      "id": "defocus_query",
      "label": "成人离焦 SQL",
      "path": "experiments/eye_illumination/results/defocus_pupil_sweep.csv",
      "query": {
        "engine": "sqlite",
        "sql": "SELECT defocus_D, printf('%+g D', defocus_D) AS defocus_label,\nblur_diameter_mm, geometric_min_angular_diameter_deg AS geometric_min_deg,\nuniform_conservative_angular_diameter_deg AS uniform_conservative_deg\nFROM defocus_pupil_sweep\nWHERE eye_id = 'adult_18y' AND pupil_diameter_mm = 5",
        "description": "报告生成器实际执行的 SQLite 查询。",
        "executed_at": "2026-08-14T00:00:00Z",
        "tables_used": [
          "defocus_pupil_sweep"
        ]
      }
    },
    {
      "id": "zos_query",
      "label": "OpticStudio 交叉验证 SQL",
      "path": "experiments/eye_illumination/results/zemax/zosapi_validation.csv",
      "query": {
        "engine": "sqlite",
        "sql": "SELECT case_id, CASE WHEN accommodated THEN '是' ELSE '否' END AS accommodated,\ntarget_radius_mm AS target_edge_mm, mean_image_y_mm AS observed_edge_mm,\nABS(mean_image_y_mm - target_radius_mm) * 1000.0 AS edge_error_um,\nrms_spread_um, valid_rays, zos_file\nFROM zosapi_validation",
        "description": "报告生成器实际执行的 SQLite 查询。",
        "executed_at": "2026-08-14T00:00:00Z",
        "tables_used": [
          "zosapi_validation"
        ]
      }
    }
  ],
